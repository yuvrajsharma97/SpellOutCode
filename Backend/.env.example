PORT=3000
# Exact origin of the frontend (no trailing slash). Requests that change
# data are rejected unless they come from this origin, and email links use it.
CLIENT_URL=http://localhost:5173
# Must be "production" on Render: enables Secure/SameSite=None cookies and hides stack traces.
NODE_ENV=development

# Proxies in front of the app (used for client IPs in rate limits).
# Optional: defaults to 1 on Render (RENDER=true is set automatically), else 0.
# Set to 2 if Cloudflare proxies your Render domain.
# TRUST_PROXY_HOPS=1

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ImageKit
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-imagekit-id>

# JWT
JWT_SECRET=<64-char-random-hex>
JWT_REFRESH_SECRET=<64-char-random-hex>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@yourdomain.com
